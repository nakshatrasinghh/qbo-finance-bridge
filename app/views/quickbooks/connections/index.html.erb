<% content_for :title, "QuickBooks sandbox connections" %>

<main>
  <h1>QuickBooks sandbox connections</h1>

  <% if notice.present? %>
    <p role="status"><%= notice %></p>
  <% end %>

  <% if alert.present? %>
    <p role="alert"><%= alert %></p>
  <% end %>

  <p>
    This is a database-free, process-local QuickBooks sandbox demo. OAuth tokens remain only in this Rails
    process and are never displayed in the browser.
  </p>
  <p role="note">
    Restarting Rails or reloading application code may discard the connection. Reconnect when that happens.
    Multiple Puma workers and production use are unsupported.
  </p>

  <% if @configuration_error %>
    <p role="alert"><strong>Configuration:</strong> <%= @configuration_error.message %></p>
  <% elsif @connection %>
    <p>
      Connected to sandbox realm <strong><%= @connection.realm_id %></strong> for this Rails process.
      <%= link_to "Open the connection", quickbooks_connection_path(@connection.id) %>
    </p>
  <% else %>
    <p><%= link_to "Connect a QuickBooks sandbox", connect_quickbooks_connections_path %></p>
    <p>No sandbox company has been connected.</p>
  <% end %>
</main>
