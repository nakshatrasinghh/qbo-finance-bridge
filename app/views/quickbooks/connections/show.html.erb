<% content_for :title, "QuickBooks sandbox company" %>

<main>
  <p><%= link_to "All connections", quickbooks_connections_path %></p>
  <h1>QuickBooks sandbox company</h1>

  <% if notice.present? %>
    <p role="status"><%= notice %></p>
  <% end %>

  <dl>
    <dt>Realm ID</dt>
    <dd><%= @connection.realm_id %></dd>
    <dt>Environment</dt>
    <dd><%= @connection.environment %></dd>
    <dt>Connection status</dt>
    <dd><%= @connection.status %></dd>
    <dt>Access token expires</dt>
    <dd><%= @connection.access_token_expires_at&.iso8601 || "—" %></dd>
    <dt>Refresh token expires</dt>
    <dd><%= @connection.refresh_token_expires_at&.iso8601 || "Not supplied by Intuit" %></dd>
  </dl>

  <% if @company_info %>
    <h2>CompanyInfo readback</h2>
    <dl>
      <dt>Company name</dt>
      <dd><%= @company_info.company_name || "—" %></dd>
      <dt>Legal name</dt>
      <dd><%= @company_info.legal_name || "—" %></dd>
      <dt>Country</dt>
      <dd><%= @company_info.country || "—" %></dd>
      <dt>Fiscal year starts</dt>
      <dd><%= @company_info.fiscal_year_start_month || "—" %></dd>
      <dt>Subscription status</dt>
      <dd><%= @company_info.subscription_status || "—" %></dd>
      <dt>Default time zone</dt>
      <dd><%= @company_info.default_time_zone || "—" %></dd>
    </dl>
    <p>The CompanyInfo read succeeded through this connection's realm-scoped endpoint.</p>
  <% elsif @quickbooks_error %>
    <p role="alert">
      CompanyInfo could not be read: <%= @quickbooks_error.message %>
      (code: <%= @quickbooks_error.code %>)
    </p>
  <% elsif @connection.disconnected? %>
    <p>This connection is disconnected; no API request was made.</p>
  <% end %>

  <% if @connection.connected? %>
    <p>
      <%= link_to "Open financial records dashboard",
                  quickbooks_connection_journal_entries_path(@connection) %>
    </p>
    <p>
      <%= link_to "Open workforce, tax, and inventory operations",
                  quickbooks_connection_operations_path(@connection) %>
    </p>
    <p>
      <%= link_to "Open sales and payables API dashboard",
                  quickbooks_connection_transactions_path(@connection) %>
    </p>

    <%= button_to "Disconnect and revoke access",
                  disconnect_quickbooks_connection_path(@connection),
                  method: :delete,
                  data: { turbo_confirm: "Revoke this sandbox connection and clear its local tokens?" } %>
  <% end %>
</main>
