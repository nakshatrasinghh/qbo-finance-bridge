<% content_for :title, "QuickBooks sandbox company" %>

<main>
  <p><%= link_to "All connections", quickbooks_connections_path %></p>
  <h1>QuickBooks sandbox company</h1>

  <% if notice.present? %>
    <p role="status"><%= notice %></p>
  <% end %>

  <dl>
    <dt>Realm ID</dt>
    <dd><%= @connection.realm_id %></dd>
    <dt>Environment</dt>
    <dd><%= @connection.environment %></dd>
    <dt>Access token expires</dt>
    <dd><%= @connection.access_token_expires_at&.iso8601 || "—" %></dd>
    <dt>Refresh token expires</dt>
    <dd><%= @connection.refresh_token_expires_at&.iso8601 || "Not supplied by Intuit" %></dd>
  </dl>

  <% if @quickbooks_error %>
    <p role="alert">
      QuickBooks connection verification failed: <%= @quickbooks_error.message %>
      (code: <%= @quickbooks_error.code %>)
    </p>
  <% end %>

  <h2>GET/POST dashboards</h2>
  <ul>
    <li>
      <%= link_to "Open financial records dashboard",
                  quickbooks_connection_journal_entries_path(@connection.id) %>
    </li>
    <li>
      <%= link_to "Open sales and payables dashboard",
                  quickbooks_connection_transactions_path(@connection.id) %>
    </li>
    <li>
      <%= link_to "Open workforce, tax, and inventory operations",
                  quickbooks_connection_operations_path(@connection.id) %>
    </li>
    <li>
      <%= link_to "Open Swagger GET/POST dashboard", api_docs_path %>.
      Use connection handle <code><%= @connection.id %></code> in its connection-scoped routes.
    </li>
  </ul>

  <p>
    Swagger calls Rails, and Rails calls QuickBooks sandbox. POST creates a real sandbox record; repeated POSTs
    may create duplicates because this demo performs no local duplicate or replay check.
  </p>
  <p role="note">
    This connection disappears after a Rails restart and may disappear after development reload. One Puma process
    is supported. This design is not suitable for production.
  </p>

  <%= button_to "Disconnect and revoke access",
                disconnect_quickbooks_connection_path(@connection.id),
                method: :delete,
                form: {
                  onsubmit: "return window.confirm('Revoke this sandbox connection and clear its in-memory tokens?')"
                } %>
</main>
