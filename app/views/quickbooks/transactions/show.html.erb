<% content_for :title, "QuickBooks sales and payables API dashboard" %>
<% content_for :head do %>
  <%= javascript_include_tag "accounting_transactions", defer: true, "data-turbo-track": "reload" %>
<% end %>

<main data-accounting-transactions
      data-customers-url="<%= api_v1_quickbooks_connection_customers_path(@connection) %>"
      data-vendors-url="<%= api_v1_quickbooks_connection_vendors_path(@connection) %>"
      data-invoices-url="<%= api_v1_quickbooks_connection_invoices_path(@connection) %>"
      data-bills-url="<%= api_v1_quickbooks_connection_bills_path(@connection) %>"
      data-customer-payments-url="<%= api_v1_quickbooks_connection_customer_payments_path(@connection) %>"
      data-bill-payments-url="<%= api_v1_quickbooks_connection_bill_payments_path(@connection) %>">
  <p>
    <%= link_to "Company connection", quickbooks_connection_path(@connection) %>
    ·
    <%= link_to "Financial reports and Journal Entries",
                quickbooks_connection_journal_entries_path(@connection) %>
    ·
    <%= link_to "Workforce, tax, and inventory", quickbooks_connection_operations_path(@connection) %>
    ·
    <%= link_to "API documentation", api_docs_path %>
  </p>

  <h1>QuickBooks sales and payables API dashboard</h1>
  <p>
    Read customers, vendors, invoices, bills, and their payments through JSON GET APIs. Each form creates one
    deliberately small sandbox record through its matching POST API after confirmation.
  </p>

  <div id="transactions-api-alert" class="api-alert" role="alert" hidden>
    <div>
      <strong id="transactions-api-alert-title">API request failed</strong>
      <p id="transactions-api-alert-message"></p>
    </div>
    <button type="button" data-dismiss-transactions-alert aria-label="Dismiss API error">Dismiss</button>
  </div>

  <p id="transactions-api-status" role="status">Loading sales and payables data through Rails APIs…</p>

  <aside class="capability-note" aria-labelledby="phase-14-boundary">
    <h2 id="phase-14-boundary">Controlled Phase 14 boundary</h2>
    <p>
      Customer and Vendor creates are non-posting list records. Invoice, Bill, Payment, and BillPayment creates
      are real accounting transactions that change sandbox receivable, payable, income, expense, cash, or
      inventory balances. Every POST requires confirmation, a UUID idempotency key, local audit reservation, and
      QuickBooks readback.
    </p>
    <p>
      Each transaction has one line and uses only active QuickBooks references. Customer payments apply to one
      open Invoice. Bill payments use Check pay type, one active bank Account, and apply to one open Bill.
    </p>
  </aside>

  <section aria-labelledby="customers-heading">
    <h2 id="customers-heading">Customers — GET and POST</h2>
    <%= form_with url: api_v1_quickbooks_connection_customers_path(@connection),
                  scope: :customer,
                  method: :post,
                  class: "filter-panel",
                  data: { customer_create_form: true } do |form| %>
      <div class="form-grid">
        <p><%= form.label :display_name %><br><%= form.text_field :display_name, required: true, maxlength: 100 %></p>
        <p><%= form.label :company_name %><br><%= form.text_field :company_name, maxlength: 100 %></p>
        <p><%= form.label :email %><br><%= form.email_field :email, maxlength: 100 %></p>
        <p><%= form.label :phone %><br><%= form.telephone_field :phone, maxlength: 30 %></p>
      </div>
      <%= form.submit "POST Customer to QuickBooks sandbox", disabled: true %>
    <% end %>
    <p id="customers-summary">Waiting for the Customers GET API…</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>ID</th><th>Customer</th><th>Company</th><th>Email</th><th>Phone</th><th>Balance</th></tr></thead>
        <tbody id="customers-rows"><tr><td colspan="6">Loading Customers…</td></tr></tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="vendors-heading">
    <h2 id="vendors-heading">Vendors — GET and POST</h2>
    <%= form_with url: api_v1_quickbooks_connection_vendors_path(@connection),
                  scope: :vendor,
                  method: :post,
                  class: "filter-panel",
                  data: { vendor_create_form: true } do |form| %>
      <div class="form-grid">
        <p><%= form.label :display_name %><br><%= form.text_field :display_name, required: true, maxlength: 100 %></p>
        <p><%= form.label :company_name %><br><%= form.text_field :company_name, maxlength: 100 %></p>
        <p><%= form.label :email %><br><%= form.email_field :email, maxlength: 100 %></p>
        <p><%= form.label :phone %><br><%= form.telephone_field :phone, maxlength: 30 %></p>
      </div>
      <%= form.submit "POST Vendor to QuickBooks sandbox", disabled: true %>
    <% end %>
    <p id="vendors-summary">Waiting for the Vendors GET API…</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>ID</th><th>Vendor</th><th>Company</th><th>Email</th><th>Phone</th><th>Balance</th></tr></thead>
        <tbody id="vendors-rows"><tr><td colspan="6">Loading Vendors…</td></tr></tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="invoices-heading">
    <h2 id="invoices-heading">Invoices — GET and POST</h2>
    <p class="danger-note">Creating an Invoice increases accounts receivable and records a sale in the sandbox.</p>
    <%= form_with url: api_v1_quickbooks_connection_invoices_path(@connection),
                  scope: :invoice,
                  method: :post,
                  class: "filter-panel",
                  data: { invoice_create_form: true } do |form| %>
      <div class="form-grid">
        <p><%= form.label :customer_id, "Customer" %><br><%= form.select :customer_id, [["Loading Customers…", ""]], {}, required: true %></p>
        <p><%= form.label :item_id, "Product or service" %><br><%= form.select :item_id, [["Loading Items…", ""]], {}, required: true %></p>
        <p><%= form.label :txn_date, "Invoice date" %><br><%= form.date_field :txn_date, value: Date.current.iso8601, required: true %></p>
        <p><%= form.label :due_date %><br><%= form.date_field :due_date, value: Date.current.next_month.iso8601, required: true %></p>
        <p><%= form.label :amount %><br><%= form.number_field :amount, min: "0.01", step: "0.01", required: true %></p>
      </div>
      <p><%= form.label :description %><br><%= form.text_field :description, required: true, maxlength: 500 %></p>
      <%= form.submit "POST Invoice to QuickBooks sandbox", disabled: true %>
    <% end %>
    <p id="invoices-summary">Waiting for the Invoices GET API…</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Date</th><th>Invoice</th><th>Customer</th><th>Total</th><th>Open balance</th><th>Lines</th></tr></thead>
        <tbody id="invoices-rows"><tr><td colspan="6">Loading Invoices…</td></tr></tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="bills-heading">
    <h2 id="bills-heading">Bills — GET and POST</h2>
    <p class="danger-note">Creating a Bill increases accounts payable and records an expense in the sandbox.</p>
    <%= form_with url: api_v1_quickbooks_connection_bills_path(@connection),
                  scope: :bill,
                  method: :post,
                  class: "filter-panel",
                  data: { bill_create_form: true } do |form| %>
      <div class="form-grid">
        <p><%= form.label :vendor_id, "Vendor" %><br><%= form.select :vendor_id, [["Loading Vendors…", ""]], {}, required: true %></p>
        <p><%= form.label :expense_account_id, "Expense account" %><br><%= form.select :expense_account_id, [["Loading Accounts…", ""]], {}, required: true %></p>
        <p><%= form.label :payable_account_id, "Accounts payable account" %><br><%= form.select :payable_account_id, [["Loading Accounts…", ""]], {}, required: true %></p>
        <p><%= form.label :txn_date, "Bill date" %><br><%= form.date_field :txn_date, value: Date.current.iso8601, required: true %></p>
        <p><%= form.label :due_date %><br><%= form.date_field :due_date, value: Date.current.next_month.iso8601, required: true %></p>
        <p><%= form.label :amount %><br><%= form.number_field :amount, min: "0.01", step: "0.01", required: true %></p>
      </div>
      <p><%= form.label :description %><br><%= form.text_field :description, required: true, maxlength: 500 %></p>
      <%= form.submit "POST Bill to QuickBooks sandbox", disabled: true %>
    <% end %>
    <p id="bills-summary">Waiting for the Bills GET API…</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Date</th><th>Bill</th><th>Vendor</th><th>Total</th><th>Open balance</th><th>Lines</th></tr></thead>
        <tbody id="bills-rows"><tr><td colspan="6">Loading Bills…</td></tr></tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="customer-payments-heading">
    <h2 id="customer-payments-heading">Customer payments — GET and POST</h2>
    <p class="danger-note">This applies one payment to one open Invoice and reduces its receivable balance.</p>
    <%= form_with url: api_v1_quickbooks_connection_customer_payments_path(@connection),
                  scope: :customer_payment,
                  method: :post,
                  class: "filter-panel",
                  data: { customer_payment_create_form: true } do |form| %>
      <div class="form-grid">
        <p><%= form.label :invoice_id, "Open invoice" %><br><%= form.select :invoice_id, [["Loading open Invoices…", ""]], {}, required: true %></p>
        <p><%= form.label :txn_date, "Payment date" %><br><%= form.date_field :txn_date, value: Date.current.iso8601, required: true %></p>
        <p><%= form.label :amount %><br><%= form.number_field :amount, min: "0.01", step: "0.01", required: true %></p>
      </div>
      <%= form.submit "POST Customer Payment to QuickBooks sandbox", disabled: true %>
    <% end %>
    <p id="customer-payments-summary">Waiting for the Customer Payments GET API…</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Date</th><th>ID</th><th>Customer</th><th>Total</th><th>Unapplied</th><th>Invoices</th></tr></thead>
        <tbody id="customer-payments-rows"><tr><td colspan="6">Loading Customer Payments…</td></tr></tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="bill-payments-heading">
    <h2 id="bill-payments-heading">Bill payments — GET and POST</h2>
    <p class="danger-note">This records one check-style payment from one bank Account against one open Bill.</p>
    <%= form_with url: api_v1_quickbooks_connection_bill_payments_path(@connection),
                  scope: :bill_payment,
                  method: :post,
                  class: "filter-panel",
                  data: { bill_payment_create_form: true } do |form| %>
      <div class="form-grid">
        <p><%= form.label :bill_id, "Open bill" %><br><%= form.select :bill_id, [["Loading open Bills…", ""]], {}, required: true %></p>
        <p><%= form.label :bank_account_id, "Bank account" %><br><%= form.select :bank_account_id, [["Loading bank Accounts…", ""]], {}, required: true %></p>
        <p><%= form.label :txn_date, "Payment date" %><br><%= form.date_field :txn_date, value: Date.current.iso8601, required: true %></p>
        <p><%= form.label :amount %><br><%= form.number_field :amount, min: "0.01", step: "0.01", required: true %></p>
      </div>
      <%= form.submit "POST Bill Payment to QuickBooks sandbox", disabled: true %>
    <% end %>
    <p id="bill-payments-summary">Waiting for the Bill Payments GET API…</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Date</th><th>ID</th><th>Vendor</th><th>Type</th><th>Bank/credit account</th><th>Total</th><th>Bills</th></tr></thead>
        <tbody id="bill-payments-rows"><tr><td colspan="7">Loading Bill Payments…</td></tr></tbody>
      </table>
    </div>
  </section>
</main>
